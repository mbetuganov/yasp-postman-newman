  "item": [
    {
      "name": "Booking_Create",
      "item": [
        {
          "name": "booking_create_variations",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 500) {\r",
                  "  console.log(\"500 Internal Server Error detected!\");\r",
                  "  return;\r",
                  "}\r",
                  "const bookingid = pm.variables.get(\"booking_id_created\");\r",
                  "const resp = pm.response.json();\r",
                  "const booking = resp.booking;\r",
                  "\r",
                  "const expectedStatus = pm.iterationData.get(\"expected_status\");\r",
                  "const firstname = pm.iterationData.get(\"td_fname\");\r",
                  "const lastname = pm.iterationData.get(\"td_lname\");\r",
                  "const totalprice = pm.iterationData.get(\"td_totalprice\");\r",
                  "const depositpaid = pm.iterationData.get(\"td_depositpaid\");\r",
                  "const checkin = pm.iterationData.get(\"td_checkin\");\r",
                  "const checkout = pm.iterationData.get(\"td_checkout\");\r",
                  "const additionalneeds = pm.iterationData.get(\"td_needs\");\r",
                  "\r",
                  "pm.test(`Status code is ${expectedStatus}`, () => {\r",
                  "    pm.response.to.have.status(expectedStatus);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"POST booking create response matches booking data\", function () {\r",
                  "  if (firstname && firstname.trim() !== \"\" && resp.hasOwnProperty(\"firstname\")) {\r",
                  "    pm.test(\"firstname matches\", () => {\r",
                  "      pm.expect(resp.firstname).to.eql();\r",
                  "    });\r",
                  "  } else {\r",
                  "    console.log(\"firstname skipped: empty in CSV\");\r",
                  "  }\r",
                  "    pm.expect(booking.lastname).to.eql(lastname);\r",
                  "    pm.expect(booking.totalprice).to.eql(totalprice);\r",
                  "    pm.expect(booking.depositpaid).to.eql(depositpaid);\r",
                  "    pm.expect(booking.bookingdates.checkin).to.eql(checkin);\r",
                  "    pm.expect(booking.bookingdates.checkout).to.eql(checkout);\r",
                  "  if (additionalneeds && additionalneeds.trim() !== \"\" && resp.hasOwnProperty(\"additionalneeds\")) {\r",
                  "    pm.test(\"additionalneeds matches\", () => {\r",
                  "      pm.expect(resp.additionalneeds).to.eql(needs.trim());\r",
                  "    });\r",
                  "  } else {\r",
                  "    console.log(\"additionalneeds skipped: empty in CSV\");\r",
                  "  }\r",
                  "});\r",
                  "\r",
                  "console.log(\"actualBooking:\", JSON.stringify(booking));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const fname = pm.variables.get(\"td_fname\");\r",
                  "const lname = pm.variables.get(\"td_lname\");\r",
                  "const price = pm.variables.get(\"td_totalprice\");\r",
                  "const deposit = pm.variables.get(\"td_depositpaid\");\r",
                  "const checkin = pm.variables.get(\"td_checkin\");\r",
                  "const checkout = pm.variables.get(\"td_checkout\");\r",
                  "const needs = pm.variables.get(\"td_needs\");\r",
                  "\r",
                  "const payload = {};\r",
                  "\r",
                  "if (fname) {\r",
                  "    payload.firstname = (fname === \"null\") ? null : fname;\r",
                  "}\r",
                  "\r",
                  "if (lname) {\r",
                  "    payload.lastname = (lname === \"null\") ? null : lname;\r",
                  "}\r",
                  "\r",
                  "if (price !== undefined && price !== null && price !== '') {\r",
                  "  if (price === 'null') {\r",
                  "    payload.totalprice = null;\r",
                  "  } else {\r",
                  "    payload.totalprice = price;\r",
                  "  }\r",
                  "}\r",
                  "\r",
                  "if (deposit !== undefined && deposit !== null && deposit !== '') {\r",
                  "  if (deposit === 'null') {\r",
                  "    payload.depositpaid = null;\r",
                  "  } else { \r",
                  "    payload.depositpaid = deposit;\r",
                  "  }\r",
                  "}\r",
                  "\r",
                  "if (checkin && checkin.trim() !== \"\" && checkout && checkout.trim() !== \"\") {\r",
                  "    payload.bookingdates = {};\r",
                  "\r",
                  "    if (checkin === \"null\" && checkout === \"null\") {\r",
                  "        payload.bookingdates.checkin = null;\r",
                  "        payload.bookingdates.checkout = null;\r",
                  "    } else if (checkin === \"null\" && checkout !== \"null\") {\r",
                  "        payload.bookingdates.checkin = null;\r",
                  "        payload.bookingdates.checkout = checkout;\r",
                  "    } else if (checkin !== \"null\" && checkout === \"null\") {\r",
                  "        payload.bookingdates.checkin = checkin;\r",
                  "        payload.bookingdates.checkout = null;\r",
                  "    } else {\r",
                  "        payload.bookingdates.checkin = checkin;\r",
                  "        payload.bookingdates.checkout = checkout;\r",
                  "    }\r",
                  "}\r",
                  "\r",
                  "if (needs) {\r",
                  "    payload.additionalneeds = (needs === \"null\") ? null : needs;\r",
                  "}\r",
                  "\r",
                  "pm.request.body.raw = JSON.stringify(payload);\r",
                  "console.log(\"Payload:\", payload);\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"firstname\" : \"{{fname}}\",\r\n    \"lastname\" : \"{{lname}}\",\r\n    \"totalprice\" : {{price}},\r\n    \"depositpaid\" : {{deposit}},\r\n    \"bookingdates\" : {\r\n        \"checkin\" : \"{{checkin}}\",\r\n        \"checkout\" : \"{{checkout}}\"\r\n    },\r\n    \"additionalneeds\" : \"{{needs}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/booking",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "booking"
              ]
            },
            "description": "Generated from cURL: curl -X POST \\\r\n  https://restful-booker.herokuapp.com/booking \\\r\n  -H 'Content-Type: application/json' \\\r\n  -d '{\r\n    \"firstname\" : \"Jim\",\r\n    \"lastname\" : \"Brown\",\r\n    \"totalprice\" : 111,\r\n    \"depositpaid\" : true,\r\n    \"bookingdates\" : {\r\n        \"checkin\" : \"2018-01-01\",\r\n        \"checkout\" : \"2019-01-01\"\r\n    },\r\n    \"additionalneeds\" : \"Breakfast\"\r\n}'"
          },
          "response": []
        }
